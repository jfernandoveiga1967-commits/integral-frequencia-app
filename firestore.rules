rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'turma', 'activities'])
        && isNonEmptyString(request.resource.data.name, 128)
        && isNonEmptyString(request.resource.data.turma, 64);
      allow delete: if true;
    }

    match /attendanceRecords/{recordId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'studentId', 'date', 'weekNumber', 'year', 'activity', 'turma', 'status', 'createdAt'])
        && isNonEmptyString(request.resource.data.studentId, 128)
        && isNonEmptyString(request.resource.data.date, 10);
      allow delete: if true;
    }

    match /turmas/{turmaId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name'])
        && isNonEmptyString(request.resource.data.name, 64);
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name', 'email', 'role'])
        && isNonEmptyString(request.resource.data.name, 128)
        && isNonEmptyString(request.resource.data.email, 128);
      allow delete: if true;
    }

    match /activities/{activityId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'name'])
        && isNonEmptyString(request.resource.data.name, 128);
      allow delete: if true;
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'turma', 'dayOfWeek', 'startTime', 'endTime', 'activityId'])
        && isNonEmptyString(request.resource.data.turma, 64)
        && isNonEmptyString(request.resource.data.activityId, 128)
        && isNonEmptyString(request.resource.data.startTime, 10)
        && isNonEmptyString(request.resource.data.endTime, 10);
      allow delete: if true;
    }

    match /holidays/{holidayId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'date', 'name', 'type'])
        && isNonEmptyString(request.resource.data.date, 10)
        && isNonEmptyString(request.resource.data.name, 128)
        && isNonEmptyString(request.resource.data.type, 32);
      allow delete: if true;
    }

    match /pontoRecords/{recordId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'userId', 'date', 'monthKey', 'status'])
        && isNonEmptyString(request.resource.data.userId, 128)
        && isNonEmptyString(request.resource.data.date, 10);
      allow delete: if true;
    }

    match /pontoClosings/{closingId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['id', 'userId', 'monthKey', 'year', 'month', 'netTotal', 'isClosed'])
        && isNonEmptyString(request.resource.data.userId, 128)
        && isNonEmptyString(request.resource.data.monthKey, 10);
      allow delete: if true;
    }

    match /test/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
