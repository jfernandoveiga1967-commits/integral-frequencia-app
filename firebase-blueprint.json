{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Information about an enrolled student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "turma": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activities": {
          "type": "array",
          "description": "List of extra activity names assigned to student"
        }
      },
      "required": ["id", "name", "turma", "activities"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily activity attendance record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "activity": { "type": "string", "maxLength": 64 },
        "turma": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["presente", "ausente", "falta_justificada"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "date", "weekNumber", "year", "activity", "turma", "status", "createdAt"]
    },
    "Turma": {
      "title": "Turma",
      "description": "Class/Turma name definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role and activity assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 64 },
        "cargoLabel": { "type": "string", "maxLength": 128 },
        "avatarColor": { "type": "string", "maxLength": 64 },
        "pin": { "type": "string", "maxLength": 16 },
        "assignedActivities": { "type": "array" },
        "assignedTurmas": { "type": "array" },
        "canManageStudents": { "type": "boolean" },
        "canMarkAttendance": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Extracurricular activity item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "icon": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "defaultEquipment": { "type": "string", "maxLength": 256 },
        "requiresRollCall": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Weekly timetable block for a turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "turma": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dayOfWeek": { "type": "string", "enum": ["segunda", "terca", "quarta", "quinta", "sexta"] },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "activityId": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 128 },
        "guidelines": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "turma", "dayOfWeek", "startTime", "endTime", "activityId"]
    },
    "Holiday": {
      "title": "Holiday",
      "description": "School holiday or recess day record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["feriado", "recesso"] },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "date", "name", "type"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all students"
    },
    "/attendanceRecords/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance records"
    },
    "/turmas/{turmaId}": {
      "schema": "Turma",
      "description": "Collection of registered turmas"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered users and roles"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Collection of extracurricular activities"
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Collection of weekly schedule blocks"
    },
    "/holidays/{holidayId}": {
      "schema": "Holiday",
      "description": "Collection of school holidays and recesses"
    }
  }
}
