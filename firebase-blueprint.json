{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Information about an enrolled student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "turma": { "type": "string", "minLength": 1, "maxLength": 64 },
        "activities": {
          "type": "array",
          "description": "List of extra activity names assigned to student"
        },
        "diasFrequencia": {
          "type": "array",
          "description": "Days of the week the student attends Integral"
        },
        "horariosSaida": {
          "type": "object",
          "description": "Exit schedule per day of the week"
        },
        "tipoContrato": {
          "type": "string",
          "maxLength": 32,
          "enum": ["regular", "avulso"]
        },
        "dataInicioContrato": { "type": "string", "maxLength": 32 },
        "dataTerminoContrato": { "type": "string", "maxLength": 32 },
        "diasContratados": {
          "type": "array",
          "description": "Days of the week contracted for temporary students"
        },
        "status": {
          "type": "string",
          "maxLength": 32,
          "enum": ["ativo", "inativo", "cancelado"]
        },
        "statusMatricula": {
          "type": "string",
          "maxLength": 32
        },
        "inactivationDate": { "type": "string", "maxLength": 32 },
        "inactivationReason": { "type": "string", "maxLength": 500 },
        "diasExtrasAvulsos": {
          "type": "array",
          "description": "Punctual single-day extra attendances booked without altering fixed weekly schedule or monthly plan"
        },
        "trocasDias": {
          "type": "array",
          "description": "Punctual day swaps between a contracted weekday and another weekday without extra charges"
        },
        "notes": { "type": "string", "maxLength": 1000 }
      },
      "required": ["id", "name", "turma", "activities"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Daily activity attendance record for a student",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "activity": { "type": "string", "maxLength": 64 },
        "turma": { "type": "string", "maxLength": 64 },
        "status": { "type": "string", "enum": ["presente", "ausente", "falta_justificada"] },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "studentId", "date", "weekNumber", "year", "activity", "turma", "status", "createdAt"]
    },
    "Turma": {
      "title": "Turma",
      "description": "Class/Turma name definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "User profile with role and activity assignments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "role": { "type": "string", "maxLength": 64 },
        "cargoLabel": { "type": "string", "maxLength": 128 },
        "avatarColor": { "type": "string", "maxLength": 64 },
        "pin": { "type": "string", "maxLength": 16 },
        "assignedActivities": { "type": "array" },
        "assignedTurmas": { "type": "array" },
        "allowedTabs": { "type": "array" },
        "canManageStudents": { "type": "boolean" },
        "canMarkAttendance": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Extracurricular activity item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "icon": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 256 },
        "defaultEquipment": { "type": "string", "maxLength": 256 },
        "requiresRollCall": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "Schedule": {
      "title": "Schedule",
      "description": "Weekly timetable block for a turma",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "turma": { "type": "string", "minLength": 1, "maxLength": 64 },
        "dayOfWeek": { "type": "string", "enum": ["segunda", "terca", "quarta", "quinta", "sexta"] },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "activityId": { "type": "string", "maxLength": 128 },
        "location": { "type": "string", "maxLength": 128 },
        "guidelines": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "turma", "dayOfWeek", "startTime", "endTime", "activityId"]
    },
    "Holiday": {
      "title": "Holiday",
      "description": "School holiday or recess day record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": { "type": "string", "enum": ["feriado", "recesso"] },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "date", "name", "type"]
    },
    "PontoRecord": {
      "title": "PontoRecord",
      "description": "Daily punch and attendance record for a collaborator",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 10 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "dayNumber": { "type": "number" },
        "entry1": { "type": "string", "maxLength": 10 },
        "exit1": { "type": "string", "maxLength": 10 },
        "entry2": { "type": "string", "maxLength": 10 },
        "exit2": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "maxLength": 32 },
        "note": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "date", "monthKey", "status"]
    },
    "PontoClosing": {
      "title": "PontoClosing",
      "description": "Monthly timesheet closing and digital signature receipt record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "year": { "type": "number" },
        "month": { "type": "number" },
        "baseSalary": { "type": "number" },
        "netTotal": { "type": "number" },
        "isClosed": { "type": "boolean" },
        "signedDigitally": { "type": "boolean" },
        "digitalSignatureHash": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "monthKey", "year", "month", "netTotal", "isClosed"]
    },
    "MealReportSettings": {
      "title": "MealReportSettings",
      "description": "Global settings for the meal financial reports such as unit price and provider",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "unitPrice": { "type": "number" },
        "providerName": { "type": "string", "maxLength": 128 },
        "responsibleCoordinator": { "type": "string", "maxLength": 128 },
        "coordinatorRole": { "type": "string", "maxLength": 128 },
        "responsibleFinancial": { "type": "string", "maxLength": 128 },
        "financialRole": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "unitPrice", "providerName"]
    },
    "MealReportConfig": {
      "title": "MealReportConfig",
      "description": "Monthly meal report and closing configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "year": { "type": "number" },
        "month": { "type": "number" },
        "startDate": { "type": "string", "maxLength": 10 },
        "endDate": { "type": "string", "maxLength": 10 },
        "defaultUnitPrice": { "type": "number" },
        "providerName": { "type": "string", "maxLength": 128 },
        "contractCompany": { "type": "string", "maxLength": 128 },
        "entries": { "type": "object" },
        "generalNotes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "monthKey", "defaultUnitPrice"]
    },
    "MonthlyMenu": {
      "title": "MonthlyMenu",
      "description": "Monthly lunch menu definition and daily items",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "year": { "type": "number" },
        "month": { "type": "number" },
        "monthName": { "type": "string", "maxLength": 32 },
        "nutritionistName": { "type": "string", "maxLength": 128 },
        "crn": { "type": "string", "maxLength": 32 },
        "contactEmail": { "type": "string", "maxLength": 128 },
        "days": { "type": "object" },
        "generalNotes": { "type": "string", "maxLength": 1000 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "monthKey", "year", "month", "nutritionistName", "crn"]
    },
    "CookingRecipe": {
      "title": "CookingRecipe",
      "description": "Cooking workshop recipes for students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "monthKey": { "type": "string", "maxLength": 10 },
        "weekNumber": { "type": "number" },
        "weekLabel": { "type": "string", "maxLength": 64 },
        "datesLabel": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 128 },
        "category": { "type": "string", "maxLength": 32 },
        "ingredients": { "type": "array" },
        "instructions": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "monthKey", "title", "ingredients", "instructions"]
    },
    "TurmaAtribuicao": {
      "title": "TurmaAtribuicao",
      "description": "Quadro de Atribuições de Turma com Monitora Responsável e Sua ADI",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "turma": { "type": "string", "minLength": 1, "maxLength": 64 },
        "monitoraId": { "type": "string", "maxLength": 128 },
        "monitoraName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "monitoraPhone": { "type": "string", "maxLength": 32 },
        "adiId": { "type": "string", "maxLength": 128 },
        "adiName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "adiPhone": { "type": "string", "maxLength": 32 },
        "horarioTurno": { "type": "string", "maxLength": 64 },
        "espacoBase": { "type": "string", "maxLength": 128 },
        "observacao": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "turma", "monitoraName", "adiName"]
    },
    "ManualNorma": {
      "title": "ManualNorma",
      "description": "Orientation item, rule or sensitive approach guideline",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "moduleId": { "type": "string", "enum": ["normas_internas", "academia_transporte", "guia_sensivel"] },
        "moduleTitle": { "type": "string", "maxLength": 128 },
        "sectionNumber": { "type": "string", "maxLength": 32 },
        "sectionTitle": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "type": "string", "enum": ["proibicao", "alerta", "recomendado", "diretriz"] },
        "summary": { "type": "string", "maxLength": 500 },
        "details": { "type": "array", "description": "List of rule details/bullets" },
        "tags": { "type": "array", "description": "Keywords for real-time search" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "moduleId", "title", "type", "summary", "details"]
    },
    "NormaAceite": {
      "title": "NormaAceite",
      "description": "Digital acknowledgment and reading confirmation of manual guidelines",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "appVersion": { "type": "string", "maxLength": 32 },
        "manualHash": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "userName", "userEmail", "timestamp", "appVersion", "manualHash"]
    },
    "RelatorioConsolidadoDia": {
      "title": "RelatorioConsolidadoDia",
      "description": "Daily consolidated attendance and meal snapshot metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 10 },
        "date": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "maxLength": 32 },
        "dayOfWeek": { "type": "string", "maxLength": 16 },
        "totalEsperados": { "type": "number" },
        "presentes": { "type": "number" },
        "faltas": { "type": "number" },
        "justificados": { "type": "number" },
        "saidasAntecipadas": { "type": "number" },
        "semEquipamento": { "type": "number" },
        "pendentes": { "type": "number" },
        "taxaPresenca": { "type": "number" },
        "isReopened": { "type": "boolean" },
        "closedAutomatically": { "type": "boolean" },
        "lastCalculatedMealsCount": { "type": "number" },
        "byTurma": { "type": "object" },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "date", "status", "presentes", "totalEsperados", "updatedAt"]
    },
    "SofiaAuditLog": {
      "title": "SofiaAuditLog",
      "description": "Audit log for Sofia write tool executions and denied attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userRole": { "type": "string", "maxLength": 64 },
        "userProfile": { "type": "string", "maxLength": 32 },
        "toolName": { "type": "string", "maxLength": 64 },
        "argsSummary": { "type": "object" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "formattedDateTime": { "type": "string", "maxLength": 64 },
        "outcome": { "type": "string", "enum": ["sucesso", "negado", "erro", "aguardando_confirmacao"] },
        "detail": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "userName", "toolName", "timestamp", "outcome"]
    },
    "SofiaAiAlert": {
      "title": "SofiaAiAlert",
      "description": "Persistent AI failure alert record (402/429/404) for coordination visibility",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "active": { "type": "boolean" },
        "code": { "type": "number" },
        "kind": { "type": "string", "maxLength": 64 },
        "message": { "type": "string", "maxLength": 500 },
        "actionUrl": { "type": "string", "maxLength": 256 },
        "detectedAt": { "type": "string", "maxLength": 64 },
        "resolvedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "active"]
    },
    "ExtraDayRecord": {
      "title": "ExtraDayRecord",
      "description": "Punctual single-day extra attendance (Dia Extra Avulso) booked for partial-week regular students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "turma": { "type": "string", "maxLength": 64 },
        "anoLetivo": { "type": "number" },
        "monthKey": { "type": "string", "maxLength": 7 },
        "date": { "type": "string", "maxLength": 10 },
        "horarioSaida": { "type": "string", "maxLength": 10 },
        "valorDiaria": { "type": "number" },
        "observacao": { "type": "string", "maxLength": 500 },
        "planoMensalAtual": { "type": "string", "maxLength": 128 },
        "statusPagamento": { "type": "string", "enum": ["PENDENTE", "EM_DIA"] },
        "formaPagamento": { "type": "string", "maxLength": 64 },
        "dataPagamento": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["ativo", "cancelado"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "studentId", "studentName", "turma", "anoLetivo", "monthKey", "date", "horarioSaida", "valorDiaria", "statusPagamento", "status", "createdAt"]
    },
    "DaySwapRecord": {
      "title": "DaySwapRecord",
      "description": "Punctual day swap between a student's contracted weekday and a substitute weekday without altering monthly billing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 128 },
        "turma": { "type": "string", "maxLength": 64 },
        "anoLetivo": { "type": "number" },
        "dataOrigem": { "type": "string", "maxLength": 10 },
        "dataDestino": { "type": "string", "maxLength": 10 },
        "horarioSaida": { "type": "string", "maxLength": 10 },
        "observacao": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["ativo", "cancelado"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "studentId", "studentName", "turma", "anoLetivo", "dataOrigem", "dataDestino", "horarioSaida", "status", "createdAt"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all students"
    },
    "/alunos/{alunoId}": {
      "schema": "Student",
      "description": "Collection of all students (legacy / compatibility)"
    },
    "/attendanceRecords/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance records"
    },
    "/turmas/{turmaId}": {
      "schema": "Turma",
      "description": "Collection of registered turmas"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered users and roles"
    },
    "/activities/{activityId}": {
      "schema": "Activity",
      "description": "Collection of extracurricular activities"
    },
    "/schedules/{scheduleId}": {
      "schema": "Schedule",
      "description": "Collection of weekly schedule blocks"
    },
    "/holidays/{holidayId}": {
      "schema": "Holiday",
      "description": "Collection of school holidays and recesses"
    },
    "/pontoRecords/{recordId}": {
      "schema": "PontoRecord",
      "description": "Collection of daily collaborator time tracking records"
    },
    "/pontoClosings/{closingId}": {
      "schema": "PontoClosing",
      "description": "Collection of monthly collaborator closing summaries and signatures"
    },
    "/settings/{settingId}": {
      "schema": "MealReportSettings",
      "description": "Global application module settings such as mealReport"
    },
    "/mealReports/{reportId}": {
      "schema": "MealReportConfig",
      "description": "Monthly meal financial closing records"
    },
    "/monthlyMenus/{menuId}": {
      "schema": "MonthlyMenu",
      "description": "Collection of monthly lunch menus"
    },
    "/cookingRecipes/{recipeId}": {
      "schema": "CookingRecipe",
      "description": "Collection of culinary workshop recipes"
    },
    "/quadroAtribuicoes/{turmaId}": {
      "schema": "TurmaAtribuicao",
      "description": "Collection of team assignments and Sua ADI by turma"
    },
    "/manual_normas/{normaId}": {
      "schema": "ManualNorma",
      "description": "Collection of guidelines, internal norms and sensitive approach items"
    },
    "/normas_aceites/{aceiteId}": {
      "schema": "NormaAceite",
      "description": "Collection of team members digital acceptance records"
    },
    "/relatoriosConsolidados/{dateId}": {
      "schema": "RelatorioConsolidadoDia",
      "description": "Daily consolidated attendance records and meal count metrics"
    },
    "/feedbacks_pedagogicos/{feedbackId}": {
      "schema": "FeedbackPedagogico",
      "description": "Collection of pedagogical feedbacks, IA messages, checklist items and monitor digital signatures"
    },
    "/sofia_audit_logs/{logId}": {
      "schema": "SofiaAuditLog",
      "description": "Audit log records for Sofia AI assistant write actions and permission denials"
    },
    "/sofia_ai_alerts/{alertId}": {
      "schema": "SofiaAiAlert",
      "description": "Persistent AI quota/availability alert records (402/429/404)"
    },
    "/extraDays/{extraDayId}": {
      "schema": "ExtraDayRecord",
      "description": "Collection of punctual Dia Extra Avulso bookings and single-day financial charges"
    },
    "/daySwaps/{swapId}": {
      "schema": "DaySwapRecord",
      "description": "Collection of punctual day swaps (troca/permuta de dia) without financial charge"
    }
  }
}
